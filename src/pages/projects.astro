---
import Base from '../layouts/Base.astro';
---

<Base title="Projects — IFFTU" description="Open source projects by IFFTU. Currently building Alexandria — decentralized, censorship-resistant knowledge preservation. The library that never burns.">
  <section class="page-header" data-watermark="P">
    <div class="page-header__inner container">
      <div class="page-header__pre text-mono animate-reveal delay-1">
        <span style="color: var(--accent);">//</span> WHAT WE BUILD
      </div>
      <h1 class="page-header__title text-display animate-reveal delay-2">
        PROJECTS
      </h1>
      <p class="page-header__desc animate-reveal delay-3">
        Every project open source. Every line of code accountable.<br class="hide-mobile" />
        We build tools that solve real problems and give them away.
      </p>
    </div>
  </section>

  <section class="projects">
    <div class="projects__inner container">
      <article class="teaser-card animate-reveal delay-3">
        <div class="teaser-card__accent"></div>

        <div class="teaser-card__header">
          <div class="teaser-card__status-row">
            <span class="teaser-card__status">
              <span class="teaser-card__status-dot"></span>
              ACTIVE DEVELOPMENT
            </span>
            <span class="text-mono" style="color: var(--gray); font-size: 0.7rem;">2025 —</span>
          </div>
          <h2 class="teaser-card__name text-display">
            ALEXANDRIA
          </h2>
        </div>

        <div class="teaser-card__body">
          <div class="teaser-card__desc-col">
            <p class="teaser-card__desc text-serif">
              A desktop and mobile application that turns every device into a full node
              in a decentralized education network with verifiable, learner-owned credentials.
              No central servers — just user-runnable relays for peer discovery. No gatekeepers. The library that never burns.
            </p>

            <div class="teaser-card__tags">
              <span class="teaser-card__tag">DECENTRALIZED</span>
              <span class="teaser-card__tag">OPEN SOURCE</span>
              <span class="teaser-card__tag">TAURI V2 + RUST</span>
              <span class="teaser-card__tag">CARDANO</span>
              <span class="teaser-card__tag">VERIFIABLE CREDENTIALS</span>
              <span class="teaser-card__tag">DID</span>
              <span class="teaser-card__tag">P2P</span>
            </div>

            <div class="teaser-card__meta text-mono">
              <span>STATUS: <span style="color: var(--accent);">OPEN SOURCE</span></span>
              <span class="teaser-card__sep">/</span>
              <span>STACK: RUST / VUE 3 / LIBP2P / IROH / SQLITE</span>
            </div>

            <div class="teaser-card__links">
              <a href="/blog/introducing-alexandria/" class="btn btn--primary">
                READ THE ANNOUNCEMENT
              </a>
              <a href="https://github.com/ifftu-dev/alexandria" class="btn btn--ghost" target="_blank" rel="noopener">
                GITHUB
              </a>
            </div>
            <a href="https://alexandria.ifftu.dev/" class="btn btn--ghost teaser-card__website-link" target="_blank" rel="noopener">
              WEBSITE
            </a>
          </div>

          <div class="teaser-card__objectives-col">
            <h3 class="teaser-card__objectives-title text-mono">WHAT IT DOES</h3>
            <ul class="teaser-card__objectives">
              <li class="teaser-card__objective">
                <span class="teaser-card__objective-index">01</span>
                Decentralized learning platform — courses, tutorials, and Opinions, content-addressed via iroh
              </li>
              <li class="teaser-card__objective">
                <span class="teaser-card__objective-index">02</span>
                Skill graph — three-tier taxonomy with Bloom's levels, ratified by domain DAOs via signed P2P gossip
              </li>
              <li class="teaser-card__objective">
                <span class="teaser-card__objective-index">03</span>
                Verifiable Credentials — W3C VCs under learner DIDs, hash-anchored to Cardano, offline-verifiable
              </li>
              <li class="teaser-card__objective">
                <span class="teaser-card__objective-index">04</span>
                Reputation — instructor impact on learner outcomes, as per-skill distributions with confidence bounds; no star ratings
              </li>
              <li class="teaser-card__objective">
                <span class="teaser-card__objective-index">05</span>
                Assessment integrity — Sentinel anti-cheat on-device; raw data never leaves the client
              </li>
              <li class="teaser-card__objective">
                <span class="teaser-card__objective-index">06</span>
                Offline-first — every operation works without the network; sync is opportunistic
              </li>
              <li class="teaser-card__objective">
                <span class="teaser-card__objective-index">07</span>
                Governance — DAOs mirror the taxonomy; proficiency-gated voting via signed P2P gossip, finalized outcomes anchored on-chain
              </li>
            </ul>
          </div>
        </div>

        <div class="teaser-card__watermark-clip" aria-hidden="true">
          <div class="teaser-card__watermark text-display">A</div>
        </div>
      </article>

      <!-- Future projects teaser -->
      <div class="projects__upcoming animate-reveal delay-4">
        <div class="projects__upcoming-border"></div>
        <div class="projects__upcoming-inner">
          <span class="text-mono" style="color: var(--gray); font-size: 0.65rem; letter-spacing: 0.15em;">MORE PROJECTS INCOMING</span>
          <p class="text-serif" style="font-size: 1.25rem; color: var(--gray-light); margin-top: 0.5rem;">
            Have an idea that fights for the users?
          </p>
          <a href="/contact/" class="btn btn--ghost" style="margin-top: 1.5rem;">
            PROPOSE A PROJECT
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ====== TEASER CARD ====== */
  .projects {
    padding: var(--space-xl) 0;
  }

  .teaser-card {
    border: 1px solid var(--border);
    padding: var(--space-lg);
    position: relative;
    margin-bottom: var(--space-lg);
    background: rgba(255, 34, 0, 0.01);
  }

  .teaser-card__accent {
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: var(--accent);
  }

  .teaser-card__watermark-clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .teaser-card__watermark {
    position: absolute;
    bottom: -15%;
    right: -3%;
    font-size: clamp(20rem, 30vw, 35rem);
    color: transparent;
    -webkit-text-stroke: 1px var(--border);
    opacity: 0.1;
    pointer-events: none;
    line-height: 0.8;
  }

  .teaser-card__header {
    margin-bottom: var(--space-lg);
    position: relative;
    z-index: 1;
  }

  .teaser-card__status-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-md);
  }

  .teaser-card__status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    color: var(--accent);
    text-transform: uppercase;
  }

  .teaser-card__status-dot {
    width: 6px;
    height: 6px;
    background: var(--accent);
    animation: flicker 1.5s ease-in-out infinite;
  }

  .teaser-card__name {
    font-size: clamp(4rem, 10vw, 8rem);
    line-height: 0.9;
  }

  .teaser-card__redacted {
    color: var(--border);
    font-size: 0.5em;
    letter-spacing: 0.2em;
    vertical-align: middle;
    margin: 0 0.25em;
  }

  .teaser-card__body {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-lg);
    position: relative;
    z-index: 1;
  }

  .teaser-card__desc {
    font-size: clamp(1.125rem, 2vw, 1.375rem);
    color: var(--gray-light);
    line-height: 1.5;
    margin-bottom: var(--space-md);
  }

  .teaser-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--space-md);
  }

  .teaser-card__tag {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--border);
    color: var(--gray-light);
  }

  .teaser-card__tag--redacted {
    color: var(--accent);
    border-color: var(--accent);
    opacity: 0.5;
  }

  .teaser-card__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    color: var(--gray);
  }

  .teaser-card__sep {
    color: var(--border);
  }

  .teaser-card__links {
    display: flex;
    gap: 1rem;
    margin-top: var(--space-md);
  }

  .teaser-card__website-link {
    display: block;
    margin-top: 0.75rem;
    text-align: center;
    width: 100%;
  }

  .teaser-card__cursor {
    color: var(--accent);
    animation: cursor-blink 1s step-end infinite;
  }

  .teaser-card__objectives-title {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: var(--gray);
    margin-bottom: var(--space-sm);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .teaser-card__objectives {
    list-style: none;
  }

  .teaser-card__objective {
    display: flex;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--gray-light);
    line-height: 1.6;
  }

  .teaser-card__objective-index {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--accent);
    opacity: 0.6;
    flex-shrink: 0;
    padding-top: 0.15rem;
  }

  .teaser-card__redacted-line {
    color: var(--border);
    letter-spacing: 0.15em;
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  /* ====== UPCOMING ====== */
  .projects__upcoming {
    text-align: center;
    padding: var(--space-lg);
    position: relative;
  }

  .projects__upcoming-border {
    height: 1px;
    background: var(--border);
    margin-bottom: var(--space-lg);
    position: relative;
  }

  .projects__upcoming-border::before {
    content: '+';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: var(--black);
    padding: 0 1rem;
    color: var(--gray);
    font-family: var(--font-mono);
    font-size: 1.5rem;
  }

  @media (max-width: 768px) {
    .teaser-card {
      padding: var(--space-md);
    }

    .teaser-card__body {
      grid-template-columns: 1fr;
    }

    .teaser-card__meta {
      flex-wrap: wrap;
    }

    .teaser-card__links {
      flex-wrap: wrap;
    }
  }
</style>
