---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

function formatDate(dateStr: string) {
  const d = new Date(dateStr);
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' }).toUpperCase();
}
---

<Base title="Blog — IFFTU" description="Dispatches from IFFTU. Essays on open source, decentralized technology, and building tools that serve humanity.">
  <section class="page-header" data-watermark="B">
    <div class="page-header__inner container">
      <div class="page-header__pre text-mono animate-reveal delay-1">
        <span style="color: var(--accent);">//</span> DISPATCHES
      </div>
      <h1 class="page-header__title text-display animate-reveal delay-2">
        BLOG
      </h1>
      <p class="page-header__desc animate-reveal delay-3">
        Updates, manifestos, and transparency reports.<br class="hide-mobile" />
        Everything in the open. Always.
      </p>
    </div>
  </section>

  <section class="blog">
    <div class="blog__inner container">
      <div class="blog__list">
        {posts.map((post, i) => (
          <a href={`/blog/${post.id}`} class={`blog-card animate-reveal delay-${i + 2}`}>
            <div class="blog-card__index text-display">{String(posts.length - i).padStart(2, '0')}</div>

            <div class="blog-card__content">
              <div class="blog-card__meta">
                <span class="text-mono">{formatDate(post.data.date)}</span>
                <span class="blog-card__sep">/</span>
                <span class="text-mono">{post.data.readTime}</span>
              </div>

              <h2 class="blog-card__title">{post.data.title}</h2>

              <p class="blog-card__excerpt">{post.data.excerpt}</p>

              <div class="blog-card__tags">
                {post.data.tags.map((tag: string) => (
                  <span class="blog-card__tag">{tag}</span>
                ))}
              </div>
            </div>

            <div class="blog-card__arrow">&rarr;</div>
          </a>
        ))}
      </div>

      <div class="teaser animate-reveal delay-5">
        <div class="teaser__border"></div>
        <div class="teaser__inner">
          <div class="teaser__status">
            <span class="teaser__dot"></span>
            <span class="text-mono">INCOMING TRANSMISSION</span>
          </div>
          <h3 class="teaser__title text-display">
            <span class="teaser__redacted">//////</span>
            ALEXANDRIA
            <span class="teaser__redacted">//////</span>
          </h3>
          <p class="teaser__text">
            The library that never burns.<br />
            <span class="teaser__glitch" data-text="Something is being built.">Something is being built.</span>
          </p>
          <div class="teaser__meta text-mono">
            <span>STATUS: <span style="color: var(--accent);">CLASSIFIED</span></span>
            <span class="teaser__sep">/</span>
            <span>ETA: <span class="teaser__cursor">_</span></span>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ====== TEASER ====== */
  .teaser {
    margin-top: var(--space-xl);
    position: relative;
  }

  .teaser__border {
    height: 1px;
    background: var(--border);
    margin-bottom: var(--space-lg);
    position: relative;
    overflow: hidden;
  }

  .teaser__border::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 60px;
    height: 100%;
    background: var(--accent);
    animation: teaser-scan 3s ease-in-out infinite;
  }

  @keyframes teaser-scan {
    0% { left: 0; opacity: 1; }
    50% { left: calc(100% - 60px); opacity: 0.5; }
    100% { left: 0; opacity: 1; }
  }

  .teaser__inner {
    border: 1px solid var(--border);
    padding: var(--space-lg);
    position: relative;
    overflow: hidden;
    background: rgba(255, 34, 0, 0.01);
  }

  .teaser__inner::after {
    content: '?';
    position: absolute;
    bottom: -25%;
    right: -5%;
    font-family: var(--font-display);
    font-size: 25rem;
    color: transparent;
    -webkit-text-stroke: 1px var(--border);
    opacity: 0.1;
    pointer-events: none;
    line-height: 1;
  }

  .teaser__status {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: var(--space-md);
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    color: var(--accent);
  }

  .teaser__dot {
    width: 6px;
    height: 6px;
    background: var(--accent);
    animation: flicker 1.5s ease-in-out infinite;
  }

  .teaser__title {
    font-size: clamp(2.5rem, 7vw, 5rem);
    line-height: 0.9;
    margin-bottom: var(--space-md);
    color: var(--white);
    position: relative;
    z-index: 1;
  }

  .teaser__redacted {
    color: var(--border);
    font-size: 0.6em;
    letter-spacing: 0.2em;
    vertical-align: middle;
    margin: 0 0.25em;
  }

  .teaser__text {
    color: var(--gray-light);
    font-size: 0.9rem;
    line-height: 1.8;
    margin-bottom: var(--space-md);
    position: relative;
    z-index: 1;
  }

  .teaser__glitch {
    position: relative;
    display: inline-block;
  }

  .teaser__glitch::before {
    content: attr(data-text);
    position: absolute;
    left: 2px;
    top: 0;
    color: var(--accent);
    opacity: 0;
    clip-path: inset(0 0 0 0);
    animation: glitch-flicker 4s ease-in-out infinite;
  }

  @keyframes glitch-flicker {
    0%, 92%, 100% { opacity: 0; }
    93% { opacity: 0.8; clip-path: inset(20% 0 40% 0); transform: translateX(-2px); }
    94% { opacity: 0; }
    95% { opacity: 0.6; clip-path: inset(60% 0 10% 0); transform: translateX(3px); }
    96% { opacity: 0; }
  }

  .teaser__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    color: var(--gray);
    position: relative;
    z-index: 1;
  }

  .teaser__sep {
    color: var(--border);
  }

  .teaser__cursor {
    color: var(--accent);
    animation: cursor-blink 1s step-end infinite;
  }

  @media (max-width: 768px) {
    .teaser__inner {
      padding: var(--space-md);
    }
  }
</style>
