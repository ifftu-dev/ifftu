---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const slugOf = (name: string) => name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  const byAuthor = new Map<string, { name: string; posts: typeof posts }>();
  for (const p of posts) {
    const slug = slugOf(p.data.author);
    const entry = byAuthor.get(slug) ?? { name: p.data.author, posts: [] };
    entry.posts.push(p);
    byAuthor.set(slug, entry);
  }
  return Array.from(byAuthor.entries()).map(([slug, { name, posts }]) => ({
    params: { slug },
    props: { authorName: name, posts: posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()) },
  }));
}

const { authorName, posts } = Astro.props;

function formatDate(dateStr: string) {
  const d = new Date(dateStr);
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: '2-digit' }).toUpperCase();
}
---

<Base title={`${authorName} — IFFTU`} description={`Posts by ${authorName} on the IFFTU blog.`}>
  <section class="page-header" data-watermark={authorName.charAt(0).toUpperCase()}>
    <div class="page-header__inner container">
      <div class="page-header__pre text-mono animate-reveal delay-1">
        <span style="color: var(--accent);">//</span> DISPATCHES BY
      </div>
      <h1 class="page-header__title text-display animate-reveal delay-2">
        {authorName.toUpperCase()}
      </h1>
      <p class="page-header__desc animate-reveal delay-3">
        {posts.length} {posts.length === 1 ? 'post' : 'posts'} published.<br class="hide-mobile" />
        <a href="/blog/" class="author-page__back">&larr; ALL POSTS</a>
      </p>
    </div>
  </section>

  <section class="blog">
    <div class="blog__inner container">
      <div class="blog__list">
        {posts.map((post, i) => (
          <a href={`/blog/${post.id}`} class={`blog-card animate-reveal delay-${i + 2}`}>
            <div class="blog-card__index text-display">{String(posts.length - i).padStart(2, '0')}</div>

            <div class="blog-card__content">
              <div class="blog-card__meta">
                <span class="text-mono">{formatDate(post.data.date)}</span>
                <span class="blog-card__sep">/</span>
                <span class="text-mono">{post.data.readTime}</span>
              </div>

              <h2 class="blog-card__title">{post.data.title}</h2>

              <p class="blog-card__excerpt">{post.data.excerpt}</p>

              <div class="blog-card__tags">
                {post.data.tags.map((tag: string) => (
                  <span class="blog-card__tag">{tag}</span>
                ))}
              </div>
            </div>

            <div class="blog-card__arrow">&rarr;</div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .author-page__back {
    color: var(--gray);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.3s, border-color 0.3s;
  }

  .author-page__back:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
</style>
