---
const currentPath = Astro.url.pathname;

const links = [
  { href: '/', label: 'INDEX' },
  { href: '/projects', label: 'PROJECTS' },
  { href: '/blog', label: 'BLOG' },
  { href: '/contact', label: 'CONTACT' },
];
---

<nav class="nav">
  <div class="nav__inner container">
    <a href="/" class="nav__logo" aria-label="IFFTU Home">
      <span class="nav__logo-mark">//</span>
      <span class="nav__logo-text">IFFTU</span>
    </a>

    <!-- Desktop links -->
    <ul class="nav__links nav__links--desktop">
      {links.map((link, i) => (
        <li>
          <a
            href={link.href}
            class:list={['nav__link', { 'nav__link--active': currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) }]}
          >
            <span class="nav__link-index">{String(i).padStart(2, '0')}</span>
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Mobile toggle -->
    <button class="nav__toggle" aria-label="Toggle menu" aria-expanded="false">
      <span class="nav__toggle-line nav__toggle-line--top"></span>
      <span class="nav__toggle-line nav__toggle-line--bottom"></span>
    </button>
  </div>
</nav>

<!-- Mobile fullscreen overlay (outside nav for clean z-index stacking) -->
<div class="mobile-menu" aria-hidden="true">
  <div class="mobile-menu__inner">
    <div class="mobile-menu__label text-mono">// NAVIGATION</div>
    <ul class="mobile-menu__links">
      {links.map((link, i) => (
        <li class="mobile-menu__item" style={`--i: ${i}`}>
          <a
            href={link.href}
            class:list={['mobile-menu__link', { 'mobile-menu__link--active': currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href)) }]}
          >
            <span class="mobile-menu__link-index text-display">{String(i).padStart(2, '0')}</span>
            <span class="mobile-menu__link-label text-display">{link.label}</span>
          </a>
        </li>
      ))}
    </ul>
    <div class="mobile-menu__footer">
      <span class="text-mono">"I FIGHT FOR THE USERS"</span>
    </div>
  </div>
</div>

<style>
  /* ====== NAV BAR ====== */
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 1.5rem 0;
    background: rgba(10, 10, 10, 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav__logo {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: 0.1em;
    text-decoration: none;
    color: var(--white);
    transition: color 0.15s;
    position: relative;
    z-index: 1001;
  }

  .nav__logo:hover {
    color: var(--accent);
  }

  .nav__logo-mark {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
  }

  /* ====== DESKTOP LINKS ====== */
  .nav__links--desktop {
    display: flex;
    list-style: none;
    gap: 0;
  }

  .nav__link {
    display: block;
    padding: 0.5rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gray-light);
    text-decoration: none;
    border: 1px solid transparent;
    transition: all 0.2s ease;
    position: relative;
  }

  .nav__link:hover {
    color: var(--white);
    border-color: var(--border);
  }

  .nav__link--active {
    color: var(--accent);
    border-color: var(--accent);
  }

  .nav__link-index {
    color: var(--gray);
    margin-right: 0.5rem;
    font-size: 0.6rem;
  }

  .nav__link--active .nav__link-index {
    color: var(--accent);
    opacity: 0.6;
  }

  /* ====== TOGGLE BUTTON ====== */
  .nav__toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1px solid var(--border);
    cursor: pointer;
    position: relative;
    z-index: 1001;
    transition: border-color 0.3s;
  }

  .nav__toggle:hover {
    border-color: var(--accent);
  }

  .nav__toggle-line {
    display: block;
    width: 20px;
    height: 1px;
    background: var(--white);
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), top 0.3s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s;
  }

  .nav__toggle-line--top {
    top: 17px;
  }

  .nav__toggle-line--bottom {
    top: 25px;
  }

  /* Toggle open state — lines become X */
  .nav__toggle.is-active .nav__toggle-line {
    background: var(--accent);
  }

  .nav__toggle.is-active .nav__toggle-line--top {
    top: 21px;
    transform: translateX(-50%) rotate(45deg);
  }

  .nav__toggle.is-active .nav__toggle-line--bottom {
    top: 21px;
    transform: translateX(-50%) rotate(-45deg);
  }

  /* ====== MOBILE OVERLAY ====== */
  .mobile-menu {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 999;
    background: var(--black);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.4s;
  }

  .mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-menu__inner {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
    padding: 6rem var(--gutter) var(--space-lg);
  }

  .mobile-menu__label {
    color: var(--gray);
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    margin-bottom: var(--space-lg);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.4s 0.1s, transform 0.4s 0.1s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-menu.is-open .mobile-menu__label {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-menu__links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
    flex-grow: 1;
  }

  .mobile-menu__item {
    border-bottom: 1px solid var(--border);
    opacity: 0;
    transform: translateX(-20px);
    transition: opacity 0.4s, transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: calc(0.15s + var(--i) * 0.06s);
  }

  .mobile-menu.is-open .mobile-menu__item {
    opacity: 1;
    transform: translateX(0);
  }

  .mobile-menu__link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1.25rem 0;
    text-decoration: none;
    color: var(--white);
    transition: color 0.2s;
  }

  .mobile-menu__link:hover,
  .mobile-menu__link--active {
    color: var(--accent);
  }

  .mobile-menu__link-index {
    font-size: 1rem;
    color: var(--border);
    min-width: 2rem;
    transition: color 0.2s;
  }

  .mobile-menu__link:hover .mobile-menu__link-index,
  .mobile-menu__link--active .mobile-menu__link-index {
    color: var(--accent);
    opacity: 0.6;
  }

  .mobile-menu__link-label {
    font-size: clamp(2rem, 8vw, 3.5rem);
    line-height: 1;
    letter-spacing: 0.04em;
  }

  .mobile-menu__footer {
    margin-top: auto;
    padding-top: var(--space-md);
    border-top: 1px solid var(--border);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.4s 0.4s, transform 0.4s 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-menu.is-open .mobile-menu__footer {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-menu__footer span {
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    color: var(--gray);
  }

  /* ====== RESPONSIVE ====== */
  @media (max-width: 768px) {
    .nav__links--desktop {
      display: none;
    }

    .nav__toggle {
      display: flex;
    }

    .mobile-menu {
      display: block;
    }
  }
</style>

<script>
  function initMobileMenu() {
    const toggle = document.querySelector('.nav__toggle');
    const menu = document.querySelector('.mobile-menu');

    function closeMenu() {
      toggle?.classList.remove('is-active');
      menu?.classList.remove('is-open');
      menu?.setAttribute('aria-hidden', 'true');
      toggle?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    toggle?.addEventListener('click', () => {
      const isOpen = toggle.classList.toggle('is-active');
      menu?.classList.toggle('is-open', isOpen);
      menu?.setAttribute('aria-hidden', String(!isOpen));
      toggle.setAttribute('aria-expanded', String(isOpen));
      document.body.style.overflow = isOpen ? 'hidden' : '';
    });

    menu?.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    // Close menu on client-side navigation
    document.addEventListener('astro:before-preparation', closeMenu);
  }

  initMobileMenu();
</script>
